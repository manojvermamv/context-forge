{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manojvermamv/context-forge/schemas/identity-envelope.schema.json",
  "title": "ContextForgeIdentityEnvelope",
  "description": "Multi-agent identity, worktree provenance, and authority tracking.",
  "type": "object",
  "properties": {
    "project_id": { "type": "string" },
    "repository": { "type": "string" },
    "commit_sha": { "type": "string" },
    "branch": { "type": "string" },
    "worktree": { "type": "string" },
    "team_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "agent_role": {
      "type": "string",
      "enum": ["architect", "developer", "reviewer", "security_auditor", "tester", "researcher", "coordinator", "human_user"]
    },
    "session_id": { "type": "string" },
    "conversation_id": { "type": "string" },
    "task_id": { "type": "string" },
    "producer": { "type": "string" },
    "producer_type": { "type": "string", "enum": ["human", "agent", "mcp_tool", "hook", "test_runner", "ci"] },
    "producer_id": { "type": "string" },
    "producer_version": { "type": "string" },
    "reviewer": { "type": "string" },
    "harness": { "type": "string" },
    "model_provider": { "type": "string" },
    "model_id": { "type": "string" },
    "authority_domain": { "type": "string", "enum": ["INTENT", "POLICY", "IMPLEMENTATION", "EXPERIENCE"] },
    "authority_level": { "type": "integer" },
    "schema_version": { "type": "string" },
    "checkpoint_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
