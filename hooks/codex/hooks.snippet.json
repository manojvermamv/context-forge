{
  "hooks": {
    "SessionStart": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"$HOME/.context-forge/scripts/brain.py\" session-start", "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & python (Join-Path $HOME '.context-forge\\scripts\\brain.py') session-start }\"", "timeout": 5, "additionalContextLimit": 1000}]}],
    "UserPromptSubmit": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"$HOME/.context-forge/scripts/brain.py\" turn-inject", "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & python (Join-Path $HOME '.context-forge\\scripts\\brain.py') turn-inject }\"", "timeout": 5, "additionalContextLimit": 500}]}],
    "PreToolUse": [{"matcher": "^(Bash|apply_patch|Edit|Write)$", "hooks": [{"type": "command", "command": "python3 \"$HOME/.context-forge/scripts/brain.py\" guard", "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & python (Join-Path $HOME '.context-forge\\scripts\\brain.py') guard }\"", "timeout": 3}]}],
    "PreCompact": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"$HOME/.context-forge/scripts/brain.py\" capture --event precompact", "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & python (Join-Path $HOME '.context-forge\\scripts\\brain.py') capture --event precompact }\"", "timeout": 3}]}],
    "Stop": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"$HOME/.context-forge/scripts/brain.py\" capture --event stop", "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & python (Join-Path $HOME '.context-forge\\scripts\\brain.py') capture --event stop }\"", "timeout": 3}]}],
    "SubagentStop": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"$HOME/.context-forge/scripts/brain.py\" capture --event subagentstop", "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & python (Join-Path $HOME '.context-forge\\scripts\\brain.py') capture --event subagentstop }\"", "timeout": 3}]}],
    "SessionEnd": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"$HOME/.context-forge/scripts/brain.py\" capture --event sessionend", "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & python (Join-Path $HOME '.context-forge\\scripts\\brain.py') capture --event sessionend }\"", "timeout": 3}]}]
  }
}
